    "menus": {
      "view/title": [
        {
          "command": "claudeProviderSwitcher.add",
          "when": "view == claudeProviderSwitcher.view",
          "group": "navigation@1"
        },
        {
          "command": "claudeProviderSwitcher.refresh",
          "when": "view == claudeProviderSwitcher.view",
          "group": "navigation@2"
        },
        {
          "command": "claudeProviderSwitcher.checkHealth",
          "when": "view == claudeProviderSwitcher.view",
          "group": "navigation@3"
        },
        {
          "command": "claudeProviderSwitcher.manageCustomProviders",
          "when": "view == claudeProviderSwitcher.view",
          "group": "1_io@1"
        },
        {
          "command": "claudeProviderSwitcher.import",
          "when": "view == claudeProviderSwitcher.view",
          "group": "1_io@2"
        },
        {
          "command": "claudeProviderSwitcher.export",
          "when": "view == claudeProviderSwitcher.view",
          "group": "1_io@3"
        },
        {
          "command": "claudeProviderSwitcher.resetUsageStats",
          "when": "view == claudeProviderSwitcher.view",
          "group": "2_usage@1"
        },
        {
          "command": "claudeProviderSwitcher.addCodex",
          "when": "view == claudeProviderSwitcher.codexView",
          "group": "navigation@1"
        },
        {
          "command": "claudeProviderSwitcher.refreshCodex",
          "when": "view == claudeProviderSwitcher.codexView",
          "group": "navigation@2"
        },
        {
          "command": "claudeProviderSwitcher.resetCodex",
          "when": "view == claudeProviderSwitcher.codexView",
          "group": "1_reset@1"
        },
        {
          "command": "claudeProviderSwitcher.checkHealth",
          "when": "view == claudeProviderSwitcher.codexView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeProviderSwitcher.test",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "inline@2"
        },
        {
          "command": "claudeProviderSwitcher.edit",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "inline@3"
        },
        {
          "command": "claudeProviderSwitcher.delete",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "inline@4"
        },
        {
          "command": "claudeProviderSwitcher.switchTo",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "0_switch@1"
        },
        {
          "command": "claudeProviderSwitcher.switchAndReload",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "0_switch@2"
        },
        {
          "command": "claudeProviderSwitcher.edit",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "1_edit@1"
        },
        {
          "command": "claudeProviderSwitcher.duplicate",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "1_edit@2"
        },
        {
          "command": "claudeProviderSwitcher.test",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "1_edit@3"
        },
        {
          "command": "claudeProviderSwitcher.pinToWorkspace",
          "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile",
          "group": "1_edit@4"
        },
