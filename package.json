{
  "name": "claude-provider-switcher",
  "displayName": "Claude Provider Switcher",
  "description": "Switch the Claude Code extension between API providers/gateways (LiteLLM, DeepSeek, MiniMax, local models, native subscription) with a sidebar UI, menu, hotkeys, and a status bar indicator.",
  "version": "0.5.1",
  "publisher": "AlekseiLobanov",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#181825",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "provider",
    "litellm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeProviderSwitcher",
          "title": "Claude Providers",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "claudeProviderSwitcher": [
        {
          "id": "claudeProviderSwitcher.view",
          "name": "Providers"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeProviderSwitcher.view",
        "contents": "No providers yet.\n[Add provider](command:claudeProviderSwitcher.add)\n\nProfiles are stored in your settings (`claudeProviderSwitcher.profiles`)."
      }
    ],
    "configuration": {
      "title": "Claude Provider Switcher",
      "properties": {
        "claudeProviderSwitcher.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "Provider profiles (no limit; hotkeys cover the first 10). Managed via the **Claude Providers** sidebar, or edited here. Selecting a profile writes its `env` to `#claudeCode.environmentVariables#`. **Do not commit real API keys.**",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable internal id; links the profile to its API key in SecretStorage. Managed automatically."
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "hotkey": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "description": "Environment variables written to claudeCode.environmentVariables. The API key (ANTHROPIC_AUTH_TOKEN) is NOT stored here — it lives in SecretStorage.",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "claudeProviderSwitcher.customProviders": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra providers added to the **Add provider** menu, on top of the ones bundled with the extension. Use this to add a provider that isn't in the built-in list. Each row pre-fills a new profile's Base URL and (optionally) the model mapping; the API key is still entered per-profile and kept in SecretStorage.\n\nFor a table editor, run **Claude Provider: Manage custom providers…** (or the *Add provider* menu → *Manage custom providers…*) instead of editing the raw JSON here.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name shown in the Add provider menu (e.g. \"My Gateway\")."
              },
              "baseUrl": {
                "type": "string",
                "description": "ANTHROPIC_BASE_URL for the provider's Anthropic-compatible endpoint (e.g. https://api.example.com/anthropic). Leave empty for a native-subscription-style entry."
              },
              "local": {
                "type": "boolean",
                "default": false,
                "description": "List this under \"Local servers\" instead of \"Anthropic-compatible providers\"."
              },
              "icon": {
                "type": "string",
                "description": "Optional logo: a PNG file name under media/providers/, or a VS Code codicon id (e.g. \"server\"). Defaults to the server codicon."
              },
              "opusModel": {
                "type": "string",
                "description": "Optional default model for the Opus tier (ANTHROPIC_DEFAULT_OPUS_MODEL)."
              },
              "sonnetModel": {
                "type": "string",
                "description": "Optional default model for the Sonnet tier (ANTHROPIC_DEFAULT_SONNET_MODEL)."
              },
              "haikuModel": {
                "type": "string",
                "description": "Optional default model for the Haiku tier (ANTHROPIC_DEFAULT_HAIKU_MODEL)."
              }
            },
            "additionalProperties": false
          }
        },
        "claudeProviderSwitcher.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the active-provider indicator in the status bar."
        },
        "claudeProviderSwitcher.applyPinnedOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "When a workspace has a pinned provider, automatically switch to it on open. Pin a provider via the sidebar (right-click → Pin to this workspace) or the command palette."
        },
        "claudeProviderSwitcher.autoFallbackOnApply": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When switching providers, first probe the target and, if it's unreachable, automatically fall back to its configured fallback provider (set per profile via **Edit → Fallback provider**). Adds a short network check to every switch. When off, use the **Switch with fallback** command for on-demand failover."
        },
        "claudeProviderSwitcher.healthCheck": {
          "type": "string",
          "enum": ["manual", "periodic"],
          "enumDescriptions": [
            "Only check reachability when you run the Check provider health command (default).",
            "Check all providers automatically on a timer (see healthCheckIntervalMinutes)."
          ],
          "default": "manual",
          "markdownDescription": "How the 🟢/🔴 reachability indicator is refreshed. The check uses `GET /v1/models`, which runs **no inference and costs no tokens**, so `periodic` is safe to leave on."
        },
        "claudeProviderSwitcher.healthCheckIntervalMinutes": {
          "type": "number",
          "minimum": 1,
          "default": 5,
          "markdownDescription": "How often (in minutes) to refresh provider health when `#claudeProviderSwitcher.healthCheck#` is `periodic`."
        }
      }
    },
    "commands": [
      { "command": "claudeProviderSwitcher.select", "title": "Select provider…", "category": "Claude Provider" },
      { "command": "claudeProviderSwitcher.add", "title": "Add provider", "category": "Claude Provider", "icon": "$(add)" },
      { "command": "claudeProviderSwitcher.refresh", "title": "Refresh", "category": "Claude Provider", "icon": "$(refresh)" },
      { "command": "claudeProviderSwitcher.switchTo", "title": "Switch to this provider", "category": "Claude Provider", "icon": "$(play)" },
      { "command": "claudeProviderSwitcher.edit", "title": "Edit provider", "category": "Claude Provider", "icon": "$(pencil)" },
      { "command": "claudeProviderSwitcher.delete", "title": "Delete provider", "category": "Claude Provider", "icon": "$(trash)" },
      { "command": "claudeProviderSwitcher.duplicate", "title": "Duplicate provider", "category": "Claude Provider", "icon": "$(copy)" },
      { "command": "claudeProviderSwitcher.moveUp", "title": "Move up", "category": "Claude Provider", "icon": "$(arrow-up)" },
      { "command": "claudeProviderSwitcher.moveDown", "title": "Move down", "category": "Claude Provider", "icon": "$(arrow-down)" },
      { "command": "claudeProviderSwitcher.test", "title": "Test connection", "category": "Claude Provider", "icon": "$(pulse)" },
      { "command": "claudeProviderSwitcher.next", "title": "Switch to next provider", "category": "Claude Provider" },
      { "command": "claudeProviderSwitcher.previous", "title": "Switch to previous provider", "category": "Claude Provider" },
      { "command": "claudeProviderSwitcher.export", "title": "Export providers…", "category": "Claude Provider", "icon": "$(export)" },
      { "command": "claudeProviderSwitcher.import", "title": "Import providers…", "category": "Claude Provider", "icon": "$(import)" },
      { "command": "claudeProviderSwitcher.switchToIndex", "title": "Switch to provider (by index)", "category": "Claude Provider" },
      { "command": "claudeProviderSwitcher.pinToWorkspace", "title": "Pin provider to this workspace", "category": "Claude Provider", "icon": "$(pin)" },
      { "command": "claudeProviderSwitcher.switchWithFallback", "title": "Switch with fallback", "category": "Claude Provider", "icon": "$(sync)" },
      { "command": "claudeProviderSwitcher.checkHealth", "title": "Check provider health", "category": "Claude Provider", "icon": "$(heart)" },
      { "command": "claudeProviderSwitcher.manageCustomProviders", "title": "Manage custom providers…", "category": "Claude Provider", "icon": "$(table)" }
    ],
    "menus": {
      "view/title": [
        { "command": "claudeProviderSwitcher.add", "when": "view == claudeProviderSwitcher.view", "group": "navigation@1" },
        { "command": "claudeProviderSwitcher.refresh", "when": "view == claudeProviderSwitcher.view", "group": "navigation@2" },
        { "command": "claudeProviderSwitcher.checkHealth", "when": "view == claudeProviderSwitcher.view", "group": "navigation@3" },
        { "command": "claudeProviderSwitcher.manageCustomProviders", "when": "view == claudeProviderSwitcher.view", "group": "1_io@1" },
        { "command": "claudeProviderSwitcher.import", "when": "view == claudeProviderSwitcher.view", "group": "1_io@2" },
        { "command": "claudeProviderSwitcher.export", "when": "view == claudeProviderSwitcher.view", "group": "1_io@3" }
      ],
      "view/item/context": [
        { "command": "claudeProviderSwitcher.test", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "inline@2" },
        { "command": "claudeProviderSwitcher.edit", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "inline@3" },
        { "command": "claudeProviderSwitcher.delete", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "inline@4" },
        { "command": "claudeProviderSwitcher.switchTo", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "0_switch@1" },
        { "command": "claudeProviderSwitcher.edit", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "1_edit@1" },
        { "command": "claudeProviderSwitcher.duplicate", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "1_edit@2" },
        { "command": "claudeProviderSwitcher.test", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "1_edit@3" },
        { "command": "claudeProviderSwitcher.pinToWorkspace", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "1_edit@4" },
        { "command": "claudeProviderSwitcher.switchWithFallback", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "1_edit@5" },
        { "command": "claudeProviderSwitcher.moveUp", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "2_order@1" },
        { "command": "claudeProviderSwitcher.moveDown", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "2_order@2" },
        { "command": "claudeProviderSwitcher.delete", "when": "view == claudeProviderSwitcher.view && viewItem == claudeProfile", "group": "3_danger@1" }
      ],
      "commandPalette": [
        { "command": "claudeProviderSwitcher.switchTo", "when": "false" },
        { "command": "claudeProviderSwitcher.edit", "when": "false" },
        { "command": "claudeProviderSwitcher.delete", "when": "false" },
        { "command": "claudeProviderSwitcher.duplicate", "when": "false" },
        { "command": "claudeProviderSwitcher.moveUp", "when": "false" },
        { "command": "claudeProviderSwitcher.moveDown", "when": "false" },
        { "command": "claudeProviderSwitcher.test", "when": "false" },
        { "command": "claudeProviderSwitcher.refresh", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "claudeProviderSwitcher.next", "key": "ctrl+alt+]", "mac": "cmd+alt+]" },
      { "command": "claudeProviderSwitcher.previous", "key": "ctrl+alt+[", "mac": "cmd+alt+[" }
    ]
  }
}